# Copy to .env (which is git-ignored) and fill in real values.

# Django SECRET_KEY. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET=change-me

# Uncomment for local development only. Leave unset (off) in production.
# DJANGO_DEBUG=1

# Required when DJANGO_DEBUG is off: comma-separated host names.
# DJANGO_ALLOWED_HOSTS=api.example.com
